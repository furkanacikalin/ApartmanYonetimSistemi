@page "/admin/announcements"
@attribute [Authorize(Roles = "Admin")]
@using ApartmanYonetimSistemi.Models
@using ApartmanYonetimSistemi.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.IO
@inject IDbContextFactory<AnnouncementContext> AnnCtxFactory
@inject IDbContextFactory<UserContext> UserCtxFactory
@inject IDbContextFactory<ApartmentContext> AptCtxFactory
@inject IWebHostEnvironment Environment

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="bi bi-megaphone text-primary me-2"></i>Duyuru Yönetimi</h3>
        <button class="btn btn-primary shadow-sm" @onclick="PrepareNewAnnouncement">
            <i class="bi bi-plus-circle"></i> Yeni Duyuru Ekle
        </button>
    </div>

    @if (showForm)
    {
        <div class="card shadow-sm mb-4 border-0 border-top border-primary border-4">
            <div class="card-header bg-white fw-bold py-3">
                @(editingId == 0 ? "Yeni Duyuru Yayınla" : "Duyuruyu Güncelle")
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Başlık</label>
                    <input @bind="currentAnn.Title" class="form-control" placeholder="Duyuru başlığını girin..." />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">İçerik</label>
                    <textarea @bind="currentAnn.Content" class="form-control" rows="4" placeholder="Duyuru detaylarını yazın..."></textarea>
                </div>

                @* --- DOSYA YÜKLEME ALANI --- *@
                <div class="mb-3">
                    <label class="form-label small fw-bold">Ek Dosya (PDF veya Görsel)</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".pdf,.png,.jpg,.jpeg" />

                    @if (!string.IsNullOrEmpty(currentAnn.AttachmentUrl))
                    {
                        <div class="form-text text-muted mt-2 d-flex align-items-center bg-light p-2 rounded">
                            <i class="bi bi-paperclip text-primary me-2"></i>
                            <span class="text-truncate" style="max-width: 300px;">Mevcut Dosya: @currentAnn.AttachmentUrl</span>
                            <button type="button" class="btn btn-link btn-sm text-danger ms-auto p-0" @onclick="RemoveCurrentAttachment">
                                <i class="bi bi-x-circle"></i> Eki Kaldır
                            </button>
                        </div>
                    }

                    @if (isUploading)
                    {
                        <div class="mt-2 text-primary small d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            Dosya işleniyor, lütfen bekleyin...
                        </div>
                    }
                </div>
                @* --------------------------- *@

                <div class="d-flex gap-2 justify-content-end">
                    <button class="btn btn-light border" @onclick="CancelForm">İptal</button>
                    <button class="btn btn-success px-4" @onclick="SaveAnnouncement" disabled="@isUploading">
                        <i class="bi bi-check-lg"></i> Kaydet
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded overflow-hidden">
            <thead class="table-dark">
                <tr>
                    <th style="width: 20%">Tarih / Durum</th>
                    <th style="width: 25%">Başlık</th>
                    <th style="width: 40%">İçerik</th>
                    <th style="width: 15%" class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (announcements == null || !announcements.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">Henüz yayınlanmış bir duyuru bulunmuyor.</td>
                    </tr>
                }
                else
                {
                    @foreach (var ann in announcements)
                    {
                        <tr>
                            <td>
                                <div class="d-flex flex-column">
                                    @if (ann.UpdatedDate.HasValue)
                                    {
                                        <div class="d-flex align-items-center">
                                            <span class="text-muted small">
                                                <i class="bi bi-clock-history me-1"></i>
                                                @ann.UpdatedDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </span>
                                            <span class="badge rounded-pill bg-info text-dark ms-2" style="font-size: 0.65rem;">
                                                Güncellendi
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="bi bi-clock me-1"></i>
                                            @ann.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="fw-bold">
                                @ann.Title
                                @if (!string.IsNullOrEmpty(ann.AttachmentUrl))
                                {
                                    <span class="badge bg-light text-primary border border-primary ms-1" title="Dosya Eki Mevcut">
                                        <i class="bi bi-paperclip"></i> Ek var
                                    </span>
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 350px;">@ann.Content</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (!string.IsNullOrEmpty(ann.AttachmentUrl))
                                    {
                                        <a href="uploads/announcements/@ann.AttachmentUrl" target="_blank" class="btn btn-outline-secondary" title="Dosyayı Gör">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    <button class="btn btn-outline-primary" @onclick="() => EditAnnouncement(ann)" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteAnnouncement(ann.Id)" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Announcement> announcements = new();
    private Announcement currentAnn = new();
    private bool showForm = false;
    private int editingId = 0;
    private int currentApartmentId;

    // Dosya yükleme için gerekli değişkenler
    private IBrowserFile? selectedFile;
    private bool isUploading = false;

    [CascadingParameter] private Task<AuthenticationState> authState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var auth = await authState;
        var userIdClaim = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (int.TryParse(userIdClaim, out int userId))
        {
            using var aptCtx = await AptCtxFactory.CreateDbContextAsync();
            var apt = await aptCtx.Apartments.AsNoTracking().FirstOrDefaultAsync(a => a.AdminUserId == userId);

            if (apt != null)
            {
                currentApartmentId = apt.Id;
                await LoadAnnouncements();
            }
        }
    }

    private async Task LoadAnnouncements()
    {
        using var annCtx = await AnnCtxFactory.CreateDbContextAsync();

        announcements = await annCtx.Announcements
            .AsNoTracking()
            .Where(a => a.ApartmentId == currentApartmentId)
            .OrderByDescending(a => a.UpdatedDate ?? a.CreatedDate)
            .ToListAsync();
    }

    private void PrepareNewAnnouncement()
    {
        currentAnn = new Announcement { ApartmentId = currentApartmentId, CreatedDate = DateTime.UtcNow };
        editingId = 0;
        selectedFile = null;
        showForm = true;
    }

    private void EditAnnouncement(Announcement ann)
    {
        currentAnn = new Announcement
        {
            Id = ann.Id,
            Title = ann.Title,
            Content = ann.Content,
            ApartmentId = ann.ApartmentId,
            CreatedDate = ann.CreatedDate,
            UpdatedDate = ann.UpdatedDate,
            AttachmentUrl = ann.AttachmentUrl
        };
        editingId = ann.Id;
        selectedFile = null;
        showForm = true;
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private void RemoveCurrentAttachment()
    {
        // Form üzerindeki ek dosya referansını kaldırır, fiziksel temizlik Save aşamasında yapılır
        currentAnn.AttachmentUrl = null;
        selectedFile = null;
    }

    private void CancelForm()
    {
        showForm = false;
        selectedFile = null;
    }

    private async Task SaveAnnouncement()
    {
        if (string.IsNullOrWhiteSpace(currentAnn.Title) || string.IsNullOrWhiteSpace(currentAnn.Content)) return;

        try
        {
            isUploading = true;

            // Yeni bir dosya seçildiyse yükleme operasyonunu başlat
            if (selectedFile != null)
            {
                var folderPath = Path.Combine(Environment.WebRootPath, "uploads", "announcements");
                if (!Directory.Exists(folderPath))
                    Directory.CreateDirectory(folderPath);

                var uniqueFileName = Guid.NewGuid().ToString() + Path.GetExtension(selectedFile.Name);
                var filePath = Path.Combine(folderPath, uniqueFileName);

                using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // Max 10MB
                using var fileStream = new FileStream(filePath, FileMode.Create);
                await stream.CopyToAsync(fileStream);

                // Güncelleme modundaysak ve eski bir dosya varsa onu diskten sil
                if (editingId != 0 && !string.IsNullOrEmpty(currentAnn.AttachmentUrl))
                {
                    DeletePhysicalFile(currentAnn.AttachmentUrl);
                }

                currentAnn.AttachmentUrl = uniqueFileName;
            }

            using var annCtx = await AnnCtxFactory.CreateDbContextAsync();

            if (editingId == 0)
            {
                annCtx.Announcements.Add(currentAnn);
            }
            else
            {
                var existing = await annCtx.Announcements.FindAsync(editingId);
                if (existing != null)
                {
                    existing.Title = currentAnn.Title;
                    existing.Content = currentAnn.Content;

                    // Eğer kullanıcı "Eki Kaldır" dediyse veya yeni dosya atandıysa güncelle
                    if (existing.AttachmentUrl != currentAnn.AttachmentUrl && !string.IsNullOrEmpty(existing.AttachmentUrl) && selectedFile == null)
                    {
                        DeletePhysicalFile(existing.AttachmentUrl);
                    }

                    existing.AttachmentUrl = currentAnn.AttachmentUrl;
                    existing.UpdatedDate = DateTime.UtcNow;
                }
            }

            await annCtx.SaveChangesAsync();
            showForm = false;
            selectedFile = null;
            await LoadAnnouncements();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dosya yükleme veya kayıt hatası: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task DeleteAnnouncement(int id)
    {
        using var annCtx = await AnnCtxFactory.CreateDbContextAsync();
        var ann = await annCtx.Announcements.FindAsync(id);

        if (ann != null)
        {
            // Veritabanından silmeden önce diskteki fiziksel dosyasını temizle
            if (!string.IsNullOrEmpty(ann.AttachmentUrl))
            {
                DeletePhysicalFile(ann.AttachmentUrl);
            }

            annCtx.Announcements.Remove(ann);
            await annCtx.SaveChangesAsync();
            await LoadAnnouncements();
        }
    }

    private void DeletePhysicalFile(string fileName)
    {
        try
        {
            var filePath = Path.Combine(Environment.WebRootPath, "uploads", "announcements", fileName);
            if (File.Exists(filePath))
            {
                File.Delete(filePath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fiziksel dosya silinemedi: {ex.Message}");
        }
    }
}